{
  "name": "civic-mcp-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "deploy": "wrangler deploy",
    "dev": "wrangler dev --port 8790",
    "format": "biome format --write",
    "lint": "biome lint --diagnostic-level=error src/",
    "lint:fix": "biome lint --fix",
    "start": "wrangler dev",
    "cf-typegen": "wrangler types",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.1.3",
    "@types/node": "^24.0.7",
    "typescript": "^5.5.2",
    "vitest": "^4.0.16",
    "wrangler": "^4.56.0"
  },
  "dependencies": {
    "@bio-mcp/shared": "workspace:*",
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "agents": "0.20.1",
    "zod": "^4.3.6"
  },
  "workspaces": [
    "packages/*"
  ]
}
